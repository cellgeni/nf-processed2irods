process {
    withName: '.*IRODS_LISTCOLLECTION' {
        // --no-exit: a not-yet-created collection writes an empty listing and
        // exits 0 instead of failing with exit 2, so a normal "nothing uploaded
        // here yet" case no longer surfaces an ignored-error NOTE in the log.
        ext.args      = "--no-exit"
        errorStrategy = { task.exitStatus == 2 ? 'ignore' : 'retry' }
        queue         = 'transfer'
        maxForks      = 10
        cpus          = 1
        array         = 100
        memory        = 2.GB
    }
}
